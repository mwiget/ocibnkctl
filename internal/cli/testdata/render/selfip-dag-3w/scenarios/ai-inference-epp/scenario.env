# ai-inference-epp variables. Override any of them from the environment.
NAMESPACE=${NAMESPACE:-scn-epp}
POOL=${POOL:-llm-pool}
# The F5EPP CR and, by the controller's naming contract, its Deployment +
# Service.
EPP=${EPP:-llm-pool-epp}
VIP=${VIP:-203.0.113.124}
HOST=${HOST:-epp.ocibnkctl.local}
REQUESTS=${REQUESTS:-10}
# What every request names. The EPP loads the tokenizer for the request's
# model from HuggingFace, so it must be an ungated repo with a tokenizer.json.
MODEL=${MODEL:-Qwen/Qwen2.5-0.5B-Instruct}
# Gateway API Inference Extension CRDs (InferencePool, ...): BNK 2.4's EPP is
# built against GAIE v1.4.0 but does not ship them. CRDs only, SHA-pinned.
GAIE_VERSION=${GAIE_VERSION:-v1.4.0}
GAIE_URL=${GAIE_URL:-https://github.com/kubernetes-sigs/gateway-api-inference-extension/releases/download/$GAIE_VERSION/manifests.yaml}
GAIE_SHA=${GAIE_SHA:-74e1ddc9394b5103e1a11df2226f4d65d7b384affaae8b88239b69a80d76c310}
export VIP
