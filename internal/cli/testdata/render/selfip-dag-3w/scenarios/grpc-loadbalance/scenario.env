# grpc-loadbalance variables. Override any of them from the environment.
NAMESPACE=${NAMESPACE:-scn-grpc}
# GRPCRoute Gateway (HTTP/2 listener) and the plain-TCP L4Route Gateway.
VIP=${VIP:-203.0.113.108}
PORT=${PORT:-50051}
L4_VIP=${L4_VIP:-203.0.113.109}
L4_PORT=${L4_PORT:-50052}
# grpcurl for the edge client, SHA-256 pinned (grpcurl_1.9.3_checksums.txt).
# With EDGE_DRIVER=external, grpcurl must be on the client's PATH instead.
GRPCURL_VERSION=${GRPCURL_VERSION:-1.9.3}
GRPCURL_SHA_X86_64=${GRPCURL_SHA_X86_64:-a926b62a85787ccf73ef8736b3ae554f1242e39d92bb8767a79d6dd23b11d1d5}
GRPCURL_SHA_ARM64=${GRPCURL_SHA_ARM64:-b20a00c1cb82ab81ec32696766d4076e99b4cb5ca0823a71767ba64dbea0f263}
export VIP L4_VIP
