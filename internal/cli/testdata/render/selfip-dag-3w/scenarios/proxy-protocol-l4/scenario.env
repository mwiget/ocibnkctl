# proxy-protocol-l4 variables. Override any of them from the environment.
NAMESPACE=${NAMESPACE:-scn-proxy}
VIP=${VIP:-203.0.113.102}
PORT=${PORT:-8000}
CURLS=${CURLS:-5}
# Body prefix the PROXY-aware nginx returns (manifests/03-backend.yaml).
MARKER=${MARKER:-ocibnkctl-scenario-proxy-protocol-OK}
export VIP
