# http-routing-e2e variables. Override any of them from the environment.
NAMESPACE=${NAMESPACE:-scn-httproute-e2e}
# Static Gateway address; it must be routable to TMM from the edge client.
VIP=${VIP:-203.0.113.100}
HOST=${HOST:-ocibnkctl.local}
GATEWAYCLASS=${GATEWAYCLASS:-bnk-gatewayclass}
# Body the nginx backend returns (manifests/04-backend.yaml).
MARKER=${MARKER:-ocibnkctl-scenario-httproute-e2e-OK}
CURLS=${CURLS:-5}
export VIP
