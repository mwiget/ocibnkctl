# fic-dynamic-ip variables. Override any of them from the environment.
NAMESPACE=${NAMESPACE:-scn-fic-dyn}
HOST=${HOST:-ocibnkctl-fic.local}
# The platform Infra IPAM pool the Gateway's address must come from
# (kit/platform/cne/infra.yaml).
POOL=${POOL:-bnk-dynamic-vips}
POOL_START=${POOL_START:-203.0.113.110}
POOL_END=${POOL_END:-203.0.113.119}
CURLS=${CURLS:-5}
MARKER=${MARKER:-ocibnkctl-scenario-fic-dynamic-ip-OK}
