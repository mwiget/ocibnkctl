# cwc-admin-access variables. Override any of them from the environment.
NAMESPACE=${NAMESPACE:-scn-cwcadmin}
# FLO's sharedComponentNamespace, where CWC and its Secrets live.
CWC_NAMESPACE=${CWC_NAMESPACE:-f5-cne-core}
CWC_URL=${CWC_URL:-https://f5-spk-cwc.$CWC_NAMESPACE.svc.cluster.local:38081/status}
