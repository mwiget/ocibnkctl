apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: scn-epp-gateway
  namespace: scn-epp
spec:
  gatewayClassName: bnk-gatewayclass
  addresses:
  - type: IPAddress
    value: ${VIP}
  listeners:
  - name: http
    protocol: HTTP
    port: 80
    allowedRoutes:
      namespaces: {from: Same}
