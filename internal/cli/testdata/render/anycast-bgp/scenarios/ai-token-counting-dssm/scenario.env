# ai-token-counting-dssm variables. Override any of them from the environment.
NAMESPACE=${NAMESPACE:-scn-aitok-dssm}
# One Gateway VIP per LB (llm-chat, llm-code, llm-embed, llm-rag).
VIP_CHAT=${VIP_CHAT:-203.0.113.120}
VIP_CODE=${VIP_CODE:-203.0.113.121}
VIP_EMBED=${VIP_EMBED:-203.0.113.122}
VIP_RAG=${VIP_RAG:-203.0.113.123}
PORT=${PORT:-8000}
# Rounds of traffic; odd rounds stream.
ROUNDS=${ROUNDS:-10}
# DSSM subtable the iRule writes and the Redis pod to read it from.
SUBTABLE=${SUBTABLE:-TMMTOK}
DSSM_POD=${DSSM_POD:-f5-dssm-db-0}
export VIP_CHAT VIP_CODE VIP_EMBED VIP_RAG
