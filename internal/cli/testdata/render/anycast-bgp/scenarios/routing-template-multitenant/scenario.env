# routing-template-multitenant variables. Override any of them from the environment.
# Two tenants, one Vrf + one tagged F5SPKVlan each, both on interface 1.1.
VLAN_INTERFACE=${VLAN_INTERFACE:-1.1}
# Each tenant has its own subnet; TMM i gets <subnet>.(SELFIP_BASE + i).
RED_SUBNET=${RED_SUBNET:-198.51.100}
GREEN_SUBNET=${GREEN_SUBNET:-198.51.101}
SELFIP_BASE=${SELFIP_BASE:-11}
# The probe peer's address on each tenant VLAN, in the node netns.
PROBE_HOST=${PROBE_HOST:-254}
# The per-node bridge TMM's interface 1.1 sits on (selfip-dag's DAG NAD).
DAG_BRIDGE=${DAG_BRIDGE:-br-f5-tmm-dag}
