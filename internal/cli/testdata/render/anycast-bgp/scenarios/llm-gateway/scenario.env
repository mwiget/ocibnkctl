# llm-gateway variables. Override any of them from the environment.
NAMESPACE=${NAMESPACE:-llm-demo}
# Fixed so the printed curl, the docs and the deck match. 203.0.113.140 is
# outside every other scenario's range.
TENANT=${TENANT:-demo}
VIP=${VIP:-203.0.113.140}
MODEL=${MODEL:-gpt-4o-mini}
# The route llm-setup.sh creates (and so its Gateway, HTTPRoute, AppPolicy and
# AIGatewayProfile): tenant-qualified, every tenant's objects share FLO's
# namespace.
ROUTE=${ROUTE:-$TENANT-llm}
PROVIDER_URL=${PROVIDER_URL:-http://mock-llm.$NAMESPACE.svc:8080/v1}
# Where apply.sh saves the virtual key for verify.sh (and ask.sh).
KEY_FILE=${KEY_FILE:-$KIT_STATE/llm-gateway/virtual-key}
# FLO's names for what it renders from CNEInstance.spec.aiGateway.
FLO_NAMESPACE=${FLO_NAMESPACE:-default}
PLATFORM_ADMIN_SECRET=${PLATFORM_ADMIN_SECRET:-f5-aigateway-admin}
CLICKHOUSE_POD=${CLICKHOUSE_POD:-f5-aigateway-clickhouse-0}
export TENANT VIP MODEL PROVIDER_URL
