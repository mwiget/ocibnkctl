# platform.env — variables for kit/platform/<phase>/install.sh, with the
# defaults of a default ocibnkctl PoC. Set any of them in the environment.
# `ocibnkctl deploy` passes its own values; TestPlatformEnvMatchesGo keeps
# the defaults here equal to ocibnkctl's pins.

# Customer secrets (paths). The FAR tarball pulls from repo.f5.com; the JWT
# licenses the cluster.
FAR_KEY=${FAR_KEY:-keys/f5-far-auth-key.tgz}
JWT_FILE=${JWT_FILE:-keys/.jwt}

# Namespaces: FLO's own, the shared components (CWC, DSSM, ...), and where
# the CNEInstance and TMM live.
OPERATOR_NAMESPACE=${OPERATOR_NAMESPACE:-f5-operators}
SHARED_NAMESPACE=${SHARED_NAMESPACE:-f5-cne-core}
BNK_NAMESPACE=${BNK_NAMESPACE:-default}

# BNK release. FLO and f5-cert-gen chart versions are resolved from this
# release manifest at install time, not pinned here.
REGISTRY=${REGISTRY:-repo.f5.com}
MANIFEST_VERSION=${MANIFEST_VERSION:-2.4.1}
MANIFEST_CHART=${MANIFEST_CHART:-oci://repo.f5.com/release/f5-bigip-k8s-manifest}
FLO_CHART=${FLO_CHART:-oci://repo.f5.com/charts/f5-lifecycle-operator}
CERT_GEN_CHART=${CERT_GEN_CHART:-oci://repo.f5.com/utils/f5-cert-gen}
# Runs f5-cert-gen's gen_cert.sh (make, openssl, python3) when they are not
# installed locally.
K8S_TOOLS_IMAGE=${K8S_TOOLS_IMAGE:-alpine/k8s:1.31.5}

# Third-party components.
CERT_MANAGER_REPO=${CERT_MANAGER_REPO:-https://charts.jetstack.io}
CERT_MANAGER_VERSION=${CERT_MANAGER_VERSION:-v1.16.2}
KYVERNO_CHART=${KYVERNO_CHART:-kyverno}
KYVERNO_REPO=${KYVERNO_REPO:-https://kyverno.github.io/kyverno/}
KYVERNO_VERSION=${KYVERNO_VERSION:-3.8.1}
MULTUS_URL=${MULTUS_URL:-https://raw.githubusercontent.com/k8snetworkplumbingwg/multus-cni/v4.1.4/deployments/multus-daemonset-thick.yml}
MULTUS_SHA=${MULTUS_SHA:-33fef64fbb67ef5d68183bad5b2aec4163dad0ebb0b63abe25343155d0d8b4be}
WHEREABOUTS_TAG=${WHEREABOUTS_TAG:-v0.8.0}
WHEREABOUTS_DS_URL=${WHEREABOUTS_DS_URL:-https://raw.githubusercontent.com/k8snetworkplumbingwg/whereabouts/v0.8.0/doc/crds/daemonset-install.yaml}
WHEREABOUTS_DS_SHA=${WHEREABOUTS_DS_SHA:-4292b79c85115823b697d99171eb701783eaecf13c0eb8d6a6657f1c5d86b2eb}
WHEREABOUTS_IPPOOL_URL=${WHEREABOUTS_IPPOOL_URL:-https://raw.githubusercontent.com/k8snetworkplumbingwg/whereabouts/v0.8.0/doc/crds/whereabouts.cni.cncf.io_ippools.yaml}
WHEREABOUTS_IPPOOL_SHA=${WHEREABOUTS_IPPOOL_SHA:-8957e53f260e5ee0ad6560743d02c609ff21e15f6c3b23851971522b3bf6027a}
WHEREABOUTS_RES_URL=${WHEREABOUTS_RES_URL:-https://raw.githubusercontent.com/k8snetworkplumbingwg/whereabouts/v0.8.0/doc/crds/whereabouts.cni.cncf.io_overlappingrangeipreservations.yaml}
WHEREABOUTS_RES_SHA=${WHEREABOUTS_RES_SHA:-59ff31b1cbe8ff7732160f3f533a71884c4bb03b18d2aa48c97b0a2aadcc4cb0}

# shrink: per-container request ceilings for tight hosts.
SHRINK_CPU=${SHRINK_CPU:-25m}
SHRINK_MEMORY=${SHRINK_MEMORY:-128Mi}
# 1 = apply the policy but do not recycle running pods.
NO_RECYCLE=${NO_RECYCLE:-}

# The data plane (docs/dataplane-modes.md): anycast-bgp | selfip-dag | standby.
DATAPLANE_MODE=${DATAPLANE_MODE:-anycast-bgp}
# Number of app=f5-tmm workers, i.e. TMM pods the DaemonSet must run.
TMM_WORKERS=${TMM_WORKERS:-1}
# anycast-bgp: TMM net1 sits on 192.168.<EDGE_OCTET>.0/24 and peers the edge
# router at EDGE_PEER_IP.
EDGE_OCTET=${EDGE_OCTET:-99}
EDGE_PEER_IP=${EDGE_PEER_IP:-192.168.$EDGE_OCTET.41}
LOCAL_AS=${LOCAL_AS:-65000}
PEER_AS=${PEER_AS:-65001}

# CNEInstance (platform/cne/cne-instance.yaml).
INSTANCE_NAME=${INSTANCE_NAME:-bnk-instance}
DEPLOYMENT_SIZE=${DEPLOYMENT_SIZE:-Small}
METRIC_SUBSYSTEM=${METRIC_SUBSYSTEM:-true}
LOGGING_SUBSYSTEM=${LOGGING_SUBSYSTEM:-false}
AIGW_ENABLED=${AIGW_ENABLED:-}
AIGW_METRICS=${AIGW_METRICS:-false}
AIGW_CONSOLE_URL=${AIGW_CONSOLE_URL:-}
GATEWAYCLASS_NAME=${GATEWAYCLASS_NAME:-bnk-gatewayclass}

# How to run a command on a cluster node (Multus bridge plugin, bridge
# netfilter): a prefix taking the node name, e.g. "docker exec" for k3s
# nodes in containers. Empty: node prep is skipped with a note — do it the
# way your nodes allow.
NODE_EXEC=${NODE_EXEC:-}
